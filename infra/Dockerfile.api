# syntax=docker/dockerfile:1.7

# ============================================================================
# Stage 1 — uv-based dependency installation
# ============================================================================
FROM python:3.12-slim AS deps

# Install uv from the official image
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# Copy dependency files first for better caching
COPY apps/api/pyproject.toml apps/api/uv.lock* ./

# Install dependencies into /app/.venv
# --frozen requires uv.lock to be in sync; --no-install-project skips installing
# the api package itself (since package=false, there's nothing to install anyway)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# ============================================================================
# Stage 2 — runtime image
# ============================================================================
FROM python:3.12-slim AS runtime

# Install minimal runtime dependencies (curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the virtual environment from the deps stage
COPY --from=deps /app/.venv /app/.venv

# Add venv to PATH so direct command invocation works
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Copy application source
COPY apps/api/src /app/src
COPY apps/api/pyproject.toml /app/pyproject.toml

# Healthcheck — uses the /health endpoint we just built
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]